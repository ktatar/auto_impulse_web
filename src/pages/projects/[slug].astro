---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { slugifyTag } from '../../lib/projects';

type ProjectEntry = CollectionEntry<'projects'>;

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.flatMap((project) => {
    const fileSlug = project.filePath
      ? project.filePath
          .replace(/\\/g, '/')
          .split('/')
          .pop()
          ?.replace(/\.md$/i, '')
      : undefined;
    const slugVariants = Array.from(
      new Set([project.id, project.id.toLowerCase(), project.id.toUpperCase(), fileSlug].filter(Boolean))
    );

    return slugVariants.map((slug) => ({
      params: { slug },
      props: { project }
    }));
  });
}

const { project } = Astro.props as { project: ProjectEntry };
const { Content } = await render(project);
const year = new Date(project.data.date).getFullYear();
---
<BaseLayout title={`${project.data.title} | Kıvanç Tatar`} description={project.data.description}>
  <article class="section content-card prose project-detail">
    <div class="card-topline">
      <p class="card-date">{year}</p>
    </div>
    <h1 class="entry-title">{project.data.title}</h1>
    <p class="page-intro">{project.data.description}</p>
    <div class="tag-row" aria-label="Project tags">
      {project.data.tags.map((tag) => (
        <a class="tag tag-link" href={`/projects?tag=${slugifyTag(tag)}`}>{tag}</a>
      ))}
    </div>
    <Content />
    <div class="card-footer">
      <a class="tag tag-link" href="/projects">ALL PROJECTS</a>
    </div>
  </article>
</BaseLayout>